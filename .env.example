# ---------------------------------------------------------------------------
# GScraper web app. Copy to .env and fill in. Never commit .env.
# Values below are production defaults for SiteGround; local-development
# overrides are noted in the comments.
# ---------------------------------------------------------------------------

APP_NAME=GScraper
# local | production
APP_ENV=production
# Generate with: php artisan key:generate
APP_KEY=
# Must be false in production (true locally for detailed error pages).
APP_DEBUG=false
# Exact public address, with https (http://localhost:8000 locally).
APP_URL=https://your-domain.com
# Timezone for displaying dates (stored in UTC).
APP_DISPLAY_TIMEZONE=Africa/Cairo

# Language new visitors see: en or ar. Each person can switch it in the top bar,
# and their choice is remembered on their own device.
APP_LOCALE=en
# Used for anything the chosen language is missing. Leave this as en.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily log files in storage/logs, kept 14 days. Use LOG_LEVEL=debug locally.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL from SiteGround Site Tools > Site > MySQL. Host is localhost on SiteGround.
# (Locally you may use DB_CONNECTION=sqlite; production must be mysql.)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Sessions in MySQL, encrypted, cookie only over HTTPS (set SESSION_SECURE_COOKIE=false for http://localhost).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# No Redis/Supervisor on shared hosting: queue and cache live in MySQL.
# The cron-driven scheduler drains the queue once a minute.
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=gscraper

# Outgoing mail (password resets). SiteGround: Site Tools > Email > Accounts,
# host mail.your-domain.com (or the SMTP host shown there), port 465 with smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.your-domain.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@your-domain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Security -------------------------------------------------------------
# Generate https:// URLs even if the proxy hides the scheme.
FORCE_HTTPS=true
# Send Strict-Transport-Security (enable only after HTTPS works on the domain).
SECURITY_HSTS=true
# SiteGround terminates HTTPS in front of Apache. Leave empty unless you see
# redirect loops or wrong client IPs; then set to *.
TRUSTED_PROXIES=

# --- Workers --------------------------------------------------------------
# Worker counts as online if seen within this many seconds.
WORKER_ONLINE_SECONDS=90
# Suggested idle polling interval sent to workers.
WORKER_POLL_SECONDS=15
# Runs with no worker contact for this long are marked failed.
WORKER_STALE_MINUTES=10

# --- Scraping budget ------------------------------------------------------
# Google rate-limits by IP address, so this budget is shared by every worker on
# the same internet connection and enforced by the server.
SCRAPE_DAILY_PER_CONNECTION=300
SCRAPE_PER_RUN=100
# While fewer than this many slots are free, searches wait (re-process still runs).
SCRAPE_MIN_RUN=10

# --- Outreach -------------------------------------------------------------
# Default for the search form's "phone calls count as a way to reach a lead".
# true when the team can call these numbers themselves (same country),
# false when outreach is written-only from abroad. WhatsApp always counts.
PHONE_IS_CHANNEL=false

# --- Limits ---------------------------------------------------------------
MAX_QUERIES_PER_RUN=50
MAX_RESULTS_PER_QUERY=200
# Legacy import upload limit (KB). PHP's upload_max_filesize must be at least this.
IMPORT_MAX_KB=20480
RUN_LOG_RETENTION_DAYS=30

# --- First admin (optional, only if you cannot use SSH) -------------------
# Set both, run `php artisan db:seed --force` once, then DELETE these two lines.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
