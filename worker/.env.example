# GScraper worker settings. Copy this file to .env and fill in the first two values.

# Address of the web app, e.g. https://leads.example.com (no trailing slash).
SERVER_URL=https://your-domain.com

# Token from the web app: Workers > Create token. Keep it secret.
WORKER_TOKEN=

# Optional: reuse an existing signed-in Chromium profile, e.g. the old GMSCraper one:
# BROWSER_PROFILE_DIR=C:\Users\you\Documents\GMSCraper\.browser-profile
BROWSER_PROFILE_DIR=

# Set to false to watch the browser while it scrapes.
HEADLESS=true

# Only for local testing against http://localhost. Never enable for a real server.
ALLOW_INSECURE_HTTP=false
