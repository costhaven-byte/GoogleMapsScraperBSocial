    "maxCrawlDelaySeconds": 20,
    "maxExtraPagesPerSite": 3
  },
  "services": {
    "web": true,
    "conversion": true,
    "paidMedia": true,
    "social": true,
    "automation": true,
    "brand": true
  },
  "priority": {
    "hot": 50,
    "warm": 30
  }
